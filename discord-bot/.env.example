# ── Discord ───────────────────────────────────────────────────────────────────
# Bot token (Discord Developer Portal → Bot → Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Application ID (Discord Developer Portal → General Information → Application ID)
CLIENT_ID=your_application_id_here

# (Optional) Register commands only in one guild for instant updates during dev.
# Leave empty to register globally (up to 1h delay).
GUILD_ID=your_guild_id_here

# ── Billgang ──────────────────────────────────────────────────────────────────
# API Key from your Billgang dashboard → Settings → Developer
BILLGANG_API_KEY=your_billgang_api_key_here

# Your shop slug/handle as it appears in your Billgang URL
# e.g. if your shop is billgang.com/billgaang → BILLGANG_SHOP_SLUG=billgaang
BILLGANG_SHOP_SLUG=your_shop_slug_here

# ── Bot Config ────────────────────────────────────────────────────────────────
# (Optional) Discord Role ID to auto-assign to verified buyers
# Leave empty to disable automatic role assignment
BUYER_ROLE_ID=
